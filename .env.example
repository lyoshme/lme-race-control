# Supabase: возьми значения из Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# (Опционально) те же значения без префикса VITE_ для Edge Function / serverless.
# На Vercel переменные с VITE_ доступны и на сервере, но для чистоты можно дублировать:
# SUPABASE_URL=${VITE_SUPABASE_URL}
# SUPABASE_ANON_KEY=${VITE_SUPABASE_ANON_KEY}
